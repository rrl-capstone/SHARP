# Secrets and personal settings: never commit
.env
config/local.yml
config/explorer.yml

# Python, build output and run logs
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
build/
*.log

# Never commit row-level data: R files, and on Explorer the DuckDB work files (one per profile,
# with the patient-level tables) and DuckDB's spill folder. build/ also holds parity/<profile>.json.
*.rds
.RData
.Rhistory
*.duckdb
*.duckdb.wal
duckdb_tmp/
data/
# ...except the website's aggregated results (built by python -m runner.site_data)
!docs/data/
*.parquet
*.feather
